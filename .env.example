# PostgreSQL connection.
# Leave DATABASE_URL empty to use the built-in database (nothing to install).
# To use your own PostgreSQL, fill it in, e.g.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/st_finbarr
DATABASE_URL=

# Any long random string, used to sign admin login cookies
SESSION_SECRET=change-me-to-a-long-random-string
